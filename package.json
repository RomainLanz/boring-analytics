{
  "name": "boring-analytics",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "start": "yarn workspace @boring-analytics/web start",
    "build": "yarn workspaces foreach -A run build",
    "dev": "yarn workspace @boring-analytics/web dev",
    "storybook": "yarn workspace @boring-analytics/design-system storybook",
    "test": "yarn workspace @boring-analytics/web test",
    "docker:up": "docker compose -f compose.dev.yml up -d --wait",
    "docker:down": "docker compose -f compose.dev.yml down",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "taze": "yarn dlx taze -r -I --maturity-period 3",
    "typecheck": "yarn workspaces foreach -A run typecheck"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "oxfmt": "^0.63.0",
    "oxlint": "1.78.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "yarn@4.17.0"
}
