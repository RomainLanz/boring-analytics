# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
ANONYMOUS_ID_SECRET=
EVENT_TIME_TOLERANCE_HOURS=24
TRUST_PROXY=loopback, linklocal, uniquelocal

# Database
DATABASE_URL=postgres://app:app@localhost:5432/app

# Session
SESSION_DRIVER=cookie
